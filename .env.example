PORT=3000
DATABASE_URL="postgresql://echogpt:echogpt@localhost:5433/echogpt?schema=public"

JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# 32 byte hex key, generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Mock AI response flag for testing without real provider API credits (default: true)
MOCK_AI_RESPONSE=true

# Mock search flag for testing without paid search API key (default: true)
MOCK_SEARCH=true


